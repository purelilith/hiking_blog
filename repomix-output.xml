        <img id="photo-preview" class="photo-preview" alt="Предпросмотр выбранного фото" hidden>
      {% endif %}

      <label for="photo">{{ 'Заменить фото (JPG, PNG, WEBP, до 5 МБ)' if editing else 'Фото маршрута (JPG, PNG, WEBP, до 5 МБ)' }}</label>
