    <p class="gear-progress" id="gear-progress" role="status"></p>
    {% for category, items in gear|groupby('category') %}
      <h3>{{ category }}</h3>
      <ul style="list-style:none; padding-left:0;">
        {% for item in items %}
          <li>
            <label class="gear-check">
              <input type="checkbox" data-gear-name="{{ item['name'] }}">
              <span>{{ item['name'] }}</span>
            </label>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>Для этого маршрута пока нет подобранного снаряжения.</p>
    {% endfor %}
  </section>
{% endblock %}

{% block scripts %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="{{ url_for('static', filename='js/tropa_map.js') }}?v=1"></script>
    <script src="{{ url_for('static', filename='js/route_map.js') }}?v=3"></script>
    <script src="{{ url_for('static', filename='js/back.js') }}?v=1" defer></script>
    <script>
    (function () {
      var sec = document.getElementById("gear-section");
      var prog = document.getElementById("gear-progress");
      if (!sec || !prog) return;
      var key = "gear_route_" + sec.dataset.routeId;
      var checks = sec.querySelectorAll("input[type='checkbox']");
      var saved = {};
      try { saved = JSON.parse(localStorage.getItem(key) || "{}"); } catch (e) {}

      function update() {
        var done = 0;
        checks.forEach(function (c) {
          if (c.checked) done++;
          saved[c.dataset.gearName] = c.checked;
        });
        prog.textContent = "Собрано: " + done + " из " + checks.length;
        try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {}
      }

      checks.forEach(function (c) {
        if (saved[c.dataset.gearName]) c.checked = true;
        c.addEventListener("change", update);
      });
      update();
    })();
  </script>
{% endblock %}
</file>

<file path="templates/route_form.html">
{% extends "base.html" %}
{% block title %}{{ 'Редактирование маршрута' if editing else 'Новый маршрут' }}{% endblock %}
