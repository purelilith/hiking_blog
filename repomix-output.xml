<file path="templates/route_detail.html">
{% extends "base.html" %}
{% block main_class %}page detail{% endblock %}
{% block title %}{{ route['title'] }}{% endblock %}
{% block head %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
{% endblock %}

{% block content %}
