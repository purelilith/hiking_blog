.btn-wide { justify-content: space-between; gap: 2rem; min-width: 13rem; }
.btn-small { padding: .42rem 1rem; font-size: .9rem; margin: 0; }

form button[type="submit"] {
  margin-top: 1.15rem; padding: .65rem 1.85rem; border: 0;
  border-radius: 999px; background: var(--accent); color: var(--accent-text); font-weight: 700;
  box-shadow: 0 6px 18px rgba(125, 140, 105, 0.26);
  transition: background-color 0.18s ease, transform 0.12s ease;
}
form button[type="submit"]:hover { background: var(--accent-hover); transform: translateY(-1px); }

/* Плавающая шапка */
.site-header {
  position: sticky; top: 0; z-index: 30;
  background: var(--header-bg);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}
.header-inner {
  max-width: 92rem; margin: 0 auto;
  display: grid; grid-template-columns: auto 1fr auto; align-items: center;
  gap: .75rem 1.25rem; padding: .9rem var(--pad);
}
.logo {
  display: inline-flex; align-items: center; gap: .55rem;
  padding: .35rem 0; background: none; border: 0;
  color: var(--text); text-decoration: none; font-weight: 700; font-size: .95rem;
}
.logo img { display: block; height: 1.85rem; width: auto; }
html[data-theme="dark"] .logo img { filter: invert(1) brightness(1.1); }

.main-nav {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: .4rem; font-size: .94rem; font-weight: 700;
}
.main-nav a {
  color: var(--text); text-decoration: none;
  padding: .42rem 1.05rem; border-radius: 999px;
  background: var(--card); border: 1px solid var(--border-subtle);
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.main-nav a:hover { background: var(--bg-elevated); border-color: var(--line); }
.main-nav a[aria-current="page"] {
  background: var(--accent); color: var(--accent-text); border-color: var(--accent);
}

.header-actions { display: flex; align-items: center; gap: .55rem; }
.user-name {
  padding: .4rem .9rem; border-radius: 999px; background: var(--card);
  border: 1px solid var(--border-subtle); font-weight: 700; color: var(--text-muted); font-size: .9rem;
}

@media (max-width: 62rem) {
  .header-inner { grid-template-columns: 1fr auto; }
  .main-nav { grid-column: 1 / -1; justify-content: flex-start; }
}

/* Панель настроек */
.settings { position: relative; }
.settings-btn {
  display: grid; place-items: center; width: 2.45rem; height: 2.45rem;
  margin: 0; padding: 0; background: var(--card); border: 1px solid var(--border-subtle);
  border-radius: 50%; color: var(--text); transition: background-color 0.15s ease, border-color 0.15s ease;
}
.settings-btn:hover, .settings-btn[aria-expanded="true"] { background: var(--bg-elevated); border-color: var(--line); }
.settings-btn .icon { width: 1.35rem; height: 1.35rem; }

.settings-panel {
  position: absolute; right: 0; top: calc(100% + .6rem); z-index: 40;
  width: min(19.5rem, 88vw); padding: 1.2rem;
  background: var(--pill-bg); color: var(--text);
  border: 1px solid var(--border-subtle); border-radius: 1.5rem;
  box-shadow: var(--shadow-hover);
}
.settings-panel[hidden] { display: none; }
.settings-group { margin-bottom: 1rem; }
.settings-title { display: block; font-weight: 700; font-size: .95rem; margin-bottom: .45rem; }
.settings-panel label { margin: 0 0 .45rem; font-size: .95rem; }

.theme-switch {
  display: grid; grid-template-columns: 1fr 1fr; gap: .35rem;
  padding: .25rem; background: var(--bg-elevated); border-radius: 999px;
}
.theme-opt {
  padding: .42rem .6rem; border: 0; border-radius: 999px;
  background: transparent; color: var(--text); font-weight: 700; font-size: .9rem;
  transition: background-color 0.15s ease, color 0.15s ease;
}
.theme-opt[aria-pressed="true"] { background: var(--accent); color: var(--accent-text); }

.settings-panel input[type="range"] {
  width: 100%; max-width: none; padding: 0; border: 0; background: none;
  accent-color: var(--accent); cursor: pointer;
}
.settings-panel .check { margin-bottom: 1rem; font-size: .95rem; cursor: pointer; }
.settings-reset { width: 100%; }

/* Главная: Скруглённый Hero-баннер с отступами по краям */
.hero-wrap {
  width: 100%;
  margin: .25rem 0 0;
  padding: 0 max(var(--pad), calc((100% - 92rem) / 2));
  background: var(--accent);
}
.hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 2rem;
  background: #2b3329;
  aspect-ratio: 16 / 8.4;
  min-height: 22rem;
  max-height: 42rem;
  container-type: inline-size;
  box-shadow: var(--shadow-hover);
}
.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 45%;
  display: block;
  z-index: 0;
}
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(16, 20, 15, 0.52) 0%,
    rgba(16, 20, 15, 0.30) 48%,
    rgba(16, 20, 15, 0.70) 100%
  );
  z-index: 1;
  pointer-events: none;
} 
.hero-center {
  position: absolute;
  z-index: 2;
  left: 6%;
  right: 6%;
  top: 22%; 
  text-align: center;
  color: #ffffff;
}
.hero-kicker {
  margin: 0 0 .1cqw;
  font-size: clamp(.95rem, 1.55cqw, 1.35rem);
  font-weight: 400;
  letter-spacing: .04em;
  opacity: .92;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.35);
}
.hero-text {
  margin: 0;
  color: #ffffff;
  font-weight: 400;
  text-shadow: 0 6px 32px rgba(0, 0, 0, 0.35);
}
.hero-big {
  display: block;
  font-family: "Gehaks", Impact, sans-serif;
  font-size: 15cqw;
  line-height: .94;
  text-transform: uppercase;
  white-space: nowrap;
}
.hero-big > span { display: inline-block; }
/* пока JS не подогнал размер под загруженный шрифт — прячем, чтобы не мигало */
html.js .hero:not(.is-fit) .hero-big { opacity: 0; }
.hero-big { transition: opacity .15s ease; }

.hero-bottom {
  position: absolute;
  z-index: 2;
  left: clamp(1.25rem, 3.2cqw, 2.75rem);
  right: clamp(1.25rem, 3.2cqw, 2.75rem);
  bottom: clamp(1.25rem, 3cqw, 2.5rem);
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem 2rem;
}
.hero-lead {
  margin: 0;
  max-width: 34rem;
  color: rgba(255, 255, 255, 0.94);
  font-size: clamp(.9rem, 1.25cqw, 1.05rem);
  line-height: 1.45;
  font-family: var(--font);
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
}
.btn-hero {
  padding: .42rem .45rem .42rem 1.3rem;
  background: rgba(63, 76, 51, 0.92);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
}
.btn-hero:hover {
  background: #ffffff;
  color: #222620;
  border-color: #ffffff;
}
.btn-circle {
  display: grid;
  place-items: center;
  width: 2.15rem;
  height: 2.15rem;
  border-radius: 50%;
  background: #ffffff;
  color: #222620;
}
.btn-hero:hover .btn-circle {
  background: var(--accent);
  color: #ffffff;
}
.btn-circle .icon { width: 1.05rem; height: 1.05rem; }

/* Секции */
.section { max-width: 92rem; margin: 0 auto; padding: 3rem var(--pad) 3.75rem; }
.section-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; }
.section-head h1, .section-head h2 { margin: 0; font-weight: 400; letter-spacing: -0.01em; }
.section-head h2 { font-size: clamp(1.65rem, 2.7vw, 2.35rem); line-height: 1.15; }
.section-sub { margin: .35rem 0 0; color: var(--text-muted); font-size: 1rem; }

/* Карточки маршрутов в эстетике референса */
.route-list { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 1.25rem; }
.route-card {
  position: relative; display: grid; grid-template-columns: minmax(11rem, 21rem) 1fr auto;
  align-items: center; gap: 1.1rem 2rem; padding: 1.15rem;
  color: var(--text); background: var(--card);
  border: 1px solid var(--border-subtle); border-radius: 1.75rem;
  box-shadow: var(--shadow);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}
.route-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); border-color: var(--accent); }
.route-card:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }

.route-thumb { position: relative; border-radius: 1.35rem; overflow: hidden; }
.route-thumb img { display: block; width: 100%; aspect-ratio: 7 / 5; object-fit: cover; transition: transform 0.35s ease; }
.route-card:hover .route-thumb img { transform: scale(1.04); }

/* Белая капсула поверх фото как на карточках в референсе */
.diff-pill {
  position: absolute; bottom: .7rem; left: 50%; transform: translateX(-50%); z-index: 1;
  white-space: nowrap;
  padding: .28rem 1rem; border-radius: 999px; font-size: .82rem; font-weight: 700;
  background: var(--pill-bg); color: var(--text);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
}
.diff-easy::before, .diff-medium::before, .diff-hard::before {
  content: ""; display: inline-block; width: .48rem; height: .48rem; border-radius: 50%;
  margin-right: .45rem; vertical-align: middle;
}
.diff-easy::before { background: #4f8a42; }
.diff-medium::before { background: #c98628; }
.diff-hard::before { background: #b8443e; }

.route-card h3 { margin: 0 0 .7rem; font-size: clamp(1.2rem, 1.8vw, 1.5rem); line-height: 1.25; }
.route-card h3 a { color: inherit; text-decoration: none; }
.route-card h3 a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
.route-card h3 a:focus-visible { outline: none; }

.meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .45rem; }
.meta li {
  display: inline-flex; align-items: center; gap: .45rem;
  padding: .32rem .85rem; border-radius: 999px;
  background: var(--pill-bg); border: 1px solid var(--border-subtle);
  font-weight: 700; font-size: .88rem; color: var(--text);
}
.meta li .icon { width: 1rem; height: 1rem; color: var(--accent); }
.badge { background: var(--accent) !important; color: var(--accent-text) !important; border-color: var(--accent) !important; }

.arrow-btn {
  display: grid; place-items: center; width: 3.5rem; height: 3.5rem; margin-right: 1rem;
  background: var(--pill-bg); border: 1px solid var(--border-subtle); border-radius: 50%;
  color: var(--text); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
}
.route-card:hover .arrow-btn { background: var(--accent); color: var(--accent-text); border-color: var(--accent); transform: translateX(3px); }
.arrow-btn .icon { width: 1.45rem; height: 1.45rem; }
.more { text-align: center; margin: 2.25rem 0 0; }

@media (max-width: 50rem) {
  .route-card { grid-template-columns: 1fr; border-radius: 1.5rem; gap: 1rem; }
  .arrow-btn { display: none; }
}

/* Внутренние страницы */
.page, .wide { margin: 0 auto; padding: 1.75rem var(--pad) 3.75rem; }
.page { max-width: 64rem; }
.wide { max-width: 92rem; }
.home .flash-wrap { max-width: 92rem; margin: 0 auto; }
.page h1, .wide h1 {
  margin: .25rem 0 1.15rem; font-weight: 400; letter-spacing: -0.015em;
  font-size: clamp(1.85rem, 3.4vw, 2.55rem); line-height: 1.15;
}
.page h2, .wide h2 { font-size: 1.3rem; margin: 0 0 .85rem; }
.card {
  background: var(--card); border: 1px solid var(--border-subtle);
  border-radius: 1.75rem; padding: 1.5rem; box-shadow: var(--shadow);
}
.flash-wrap { padding: 1rem var(--pad) 0; }
.message { padding: .8rem 1.15rem; border: 1px solid #c94a4a; border-radius: 1rem; background: #fdf0f0; color: #5c1616; font-weight: 700; }

label { display: block; margin-top: 1rem; font-weight: 700; font-size: .94rem; }
.check { display: flex; align-items: center; margin: 0; }
input, select, textarea {
  font: inherit; padding: .6rem .9rem; max-width: 100%; color: var(--text);
  background: var(--pill-bg); border: 1.5px solid var(--input-border); border-radius: .9rem;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
input { width: 100%; max-width: 24rem; }
input[type="checkbox"] { width: 1.15rem; height: 1.15rem; padding: 0; margin-right: .55rem; accent-color: var(--accent); }
textarea, select { width: 100%; max-width: 40rem; }
fieldset { margin-top: 1.5rem; border: 1px solid var(--border-subtle); border-radius: 1.25rem; padding: 1.15rem 1.35rem; background: var(--pill-bg); }
legend { font-weight: 700; padding: 0 .6rem; color: var(--line); }
form.card { max-width: 44rem; }
#map { height: 22rem; max-width: 100%; margin-top: .5rem; border-radius: 1.35rem; border: 1px solid var(--border-subtle); overflow: hidden; }

html[data-theme="dark"] .leaflet-tile-pane {
  filter: invert(100%) hue-rotate(180deg) brightness(92%) contrast(90%);
}

.filters-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .65rem 1rem; }
.filters-grid label { margin-top: 0; font-size: .88rem; color: var(--text-muted); }
.filters-grid input, .filters-grid select { max-width: none; }
.filters-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.25rem; }
.filters-actions button { margin-top: 0; }
.pager { display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 2rem; }
.empty { list-style: none; text-align: center; padding: 2.5rem 1.5rem; }

.chips { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0 0 .75rem; padding: 0; }
.chips li {
  padding: .32rem 1rem; border: 1px solid var(--border-subtle); border-radius: 999px;
  font-weight: 700; font-size: .92rem; background: var(--card);
}
.byline { margin: 0 0 1.1rem; color: var(--text-muted); }
.manage {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .75rem;
  margin-bottom: 1.1rem;
}
.manage form {
  display: inline-flex;
  align-items: center;
  margin: 0;
}
.manage .btn,
.manage form button[type="submit"] {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 2.55rem;
  padding: 0 1.35rem;
  margin: 0;
  font-size: .95rem;
  font-weight: 700;
  line-height: 1;
  border-radius: 999px;
  box-sizing: border-box;
  transform: none;
}
.manage .btn:hover,
.manage form button[type="submit"]:hover {
  transform: translateY(-1px);
}
.detail-photo { display: block; width: 100%; max-height: 25rem; object-fit: cover; border-radius: 1.75rem; margin-bottom: 1.35rem; box-shadow: var(--shadow); }
.detail .card { margin-top: 1.35rem; }
.prewrap { white-space: pre-wrap; margin: 0; }
dt { font-weight: 700; margin-top: .85rem; color: var(--text-muted); font-size: .9rem; }
dt:first-child { margin-top: 0; }
dd { margin: .2rem 0 0; }

.gear-check { display: flex; align-items: center; gap: .6rem; padding: .35rem 0; cursor: pointer; font-weight: 400; margin: 0; }
.gear-check input:checked + span { text-decoration: line-through; color: var(--text-muted); }
.gear-progress { font-weight: 700; color: var(--accent); margin-bottom: .75rem; }

.site-footer { padding: 2rem var(--pad); border-top: 1px solid var(--border-subtle); background: var(--bg-elevated); }
.footer-inner { max-width: 92rem; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem; }
.site-footer p { margin: 0; }
.footer-note { color: var(--text-muted); font-size: .92rem; }

/* Единая типографика на Inter: заголовки жирные (700), текст регулярный (400) */
body,
input,
select,
textarea,
button {
  font-family: var(--font);
  font-weight: 400;
}

h1, h2, h3, h4,
.section-head h1,
.section-head h2,
.page h1,
.wide h1,
.page h2,
.wide h2,
.route-card h3 {
  font-weight: 700;
  letter-spacing: -0.02em;
}

.prewrap,
.detail .card p,
.detail dd,
.page p,
.page li {
  font-size: 1.05rem;
  line-height: 1.65;
}

.hero-kicker {
  font-family: "Panama", serif;
  font-size: clamp(1.15rem, 2.1cqw, 1.75rem); /* было clamp(.95rem, 1.55cqw, 1.35rem) */
}

.hero-lead {
  font-family: var(--font); 
  font-size: clamp(1rem, 1.35cqw, 1.15rem);
  max-width: 36rem;
}

/* Назад, посты с фото, места на карте */
.back-link { display: inline-flex; align-items: center; gap: .4rem; margin-bottom: .75rem; padding: .3rem .9rem;
             font-weight: 700; color: var(--text); text-decoration: none; background: var(--pill-bg);
             border: 1px solid var(--border-subtle); border-radius: 999px; }
.back-link:hover { background: var(--bg-elevated); border-color: var(--line); }
.hint { margin: 0 0 .5rem; color: var(--text-muted); font-size: .92rem; }
input[type="radio"] { width: 1.15rem; height: 1.15rem; padding: 0; margin-right: .55rem; accent-color: var(--accent); }
.photo-list { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .6rem; }
.photo-list li { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem; }
.photo-list img { border-radius: .6rem; object-fit: cover; }
.photo-list span { flex: 1 1 12rem; }
.mode-switch { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-bottom: .5rem; }
.places-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
.place-item { padding: 1rem; border: 2px solid var(--line); border-radius: 1.1rem; background: var(--pill-bg); }
.place-item input { max-width: none; }
.place-item button { margin-top: .75rem; }
.post p { margin: 0 0 1rem; }
.post-photo { margin: 1.25rem 0; }
.post-photo img { display: block; width: 100%; max-height: 32rem; object-fit: cover; border-radius: 1.25rem; }
.post-photo figcaption { margin-top: .4rem; color: var(--text-muted); font-size: .92rem; text-align: center; }
.places-view { padding-left: 1.25rem; }
.places-view .coords { color: var(--text-muted); font-size: .88rem; }
details summary { cursor: pointer; font-weight: 700; margin-top: .75rem; }
.photo-preview { display: block; max-width: 100%; max-height: 16rem; margin-bottom: .75rem; border-radius: 1rem; object-fit: cover; }
.photo-preview[hidden] { display: none; }
.post-block { margin-top: .75rem;  padding: 1rem; background: var(--pill-bg);
              border: 2px solid var(--line); border-radius: 1.1rem; }
.post-block-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
                   gap: .5rem; margin-bottom: .5rem; }
.post-block-bar { display: flex; flex-wrap: wrap; gap: .4rem; }
.post-block textarea { width: 100%; max-width: none; }
.post-block .btn-small { margin-top: 0; }
.post-photo-body .btn { margin-top: .75rem; }
.post-thumb[hidden] { display: none; max-width: 100%; max-height: 14rem; border-radius: .9rem; object-fit: cover;  margin-top: .75rem; }
.post-caption { margin: .5rem 0 0; color: var(--text-muted); }
.post-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
.post-block--error { border: 2px solid #b00020; }
.message[hidden] { display: none; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
  .btn:hover, .btn:active, .route-card:hover { transform: none; }
}
.tags { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; margin: 0 0 .6rem; padding: 0; }
.tag { padding: .15rem .7rem; font-size: .8rem; font-weight: 700; color: var(--text);
       background: var(--pill-bg); border: 1.5px solid var(--line); border-radius: 999px; }
.tag--verified { color: var(--accent-text); background: var(--accent); border-color: var(--accent); }
.tag--closed { color: #fff; background: #8f1d1d; border-color: #8f1d1d; }
.tag--warn { color: #4a3300; background: #fff3d6; border-color: #b8860b; }
html[data-theme="dark"] .tag--closed { color: #ffd7d7; background: #5c1616; border-color: #c24a4a; }
html[data-theme="dark"] .tag--warn { color: #ffe9a8; background: #3a2e12; border-color: #c9a227; }
