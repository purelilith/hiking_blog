    </fieldset>

    {% set plist = [] %}
    {% for p in photos %}
      {% set _ = plist.append({"id": p['id'], "url": url_for('static', filename='img/posts/' ~ p['filename']), "caption": p['caption']}) %}
    {% endfor %}
    <fieldset id="post-editor" data-photos='{{ plist | tojson }}' data-upload-url="{{ url_for('routes.upload_photo') }}">
      <legend>Описание маршрута</legend>
      <p class="hint">Расскажите о маршруте: добавляйте текстовые блоки и фото друг за другом. Блоки можно двигать вверх и вниз кнопками «Выше» и «Ниже».</p>
      <div id="post-blocks"></div>
      <div class="post-actions">
        <button type="button" class="btn btn-small" id="add-text-block">+ Добавить текст</button>
        <button type="button" class="btn btn-small" id="add-photo-block">+ Добавить фото</button>
      </div>
      <p id="post-status" role="status"></p>
      <input type="hidden" id="description" name="description" value="{{ form.get('description', '') }}">
    </fieldset>

    <fieldset>
      <legend>Ограничения и источник</legend>
      <label for="restrictions">Ограничения (пропуска, заповедная зона и т.д.)</label>
      <input id="restrictions" name="restrictions" type="text" value="{{ form.get('restrictions', '') }}">
      <label for="source_url">Ссылка на официальный источник (https://...)</label>
      <input id="source_url" name="source_url" type="url" value="{{ form.get('source_url', '') }}">
      <label for="open_from">Маршрут открыт с</label>
      <input id="open_from" name="open_from" type="date" value="{{ form.get('open_from', '') }}">
      <label for="open_to">Маршрут открыт по</label>
      <input id="open_to" name="open_to" type="date" value="{{ form.get('open_to', '') }}">
      <label for="source_checked">Когда собраны и проверены данные</label>
      <input id="source_checked" name="source_checked" type="date" value="{{ form.get('source_checked', '') }}">
    </fieldset>

        <fieldset>
      <legend>Маршрут на карте</legend>
      <p>Сначала проведите линию маршрута (точек можно ставить сколько нужно, хоть на каждом повороте), потом отметьте названными местами важные локации: привалы, виды, ручьи.</p>
      <div class="mode-switch" role="radiogroup" aria-label="Что ставить по щелчку на карте">
        <label class="check"><input type="radio" name="map-mode" value="path" checked> Линия маршрута</label>
        <label class="check"><input type="radio" name="map-mode" value="place"> Место с названием</label>
      </div>
      <p id="live-distance" style="font-weight:700; color:var(--accent);"></p>
      <div id="map" role="region" aria-label="Карта для расстановки линии маршрута и мест"></div>

      <label for="lat-input">Широта</label>
      <input id="lat-input" type="text" inputmode="decimal">
      <label for="lon-input">Долгота</label>
      <input id="lon-input" type="text" inputmode="decimal">
      <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-top:.75rem;">
